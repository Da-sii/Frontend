default_platform(:android)

platform :android do
  desc "Build AAB and upload to Google Play internal track"
  lane :internal do
    version_name = ENV["CI_VERSION_NAME"]
    UI.user_error!("버전명을 입력해 주세요.") if version_name.to_s.strip.empty?

    # Google Play에 올라간 최신 코드와 프로젝트 기본값 중 큰 값 다음 번호를 사용합니다.
    play_codes = %w[internal production beta alpha].flat_map do |track|
      google_play_track_version_codes(
        package_name: "com.dasii",
        track: track,
        json_key_data: ENV["SUPPLY_JSON_KEY_DATA"]
      )
    end
    default_code = File.read("app/build.gradle")[/^\s*versionCode\s+(\d+)/, 1].to_i
    version_code = ([default_code] + play_codes).max + 1
    UI.message("Google Play 배포 버전: #{version_name} (#{version_code})")

    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "VERSION_NAME" => version_name,
        "VERSION_CODE" => version_code
      }
    )

    aab_path = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH] || lane_context[SharedValues::GRADLE_ALL_AAB_OUTPUT_PATHS]&.first

    UI.user_error!("AAB 경로를 찾지 못했어요. GRADLE_*_AAB_OUTPUT_PATHS 확인 필요") unless aab_path

    # ✅ Play 업로드
    upload_to_play_store(
      package_name: "com.dasii",
      track: "internal",
      aab: aab_path,
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
